# ══════════════════════════════════════════════════════════════
#  STR Comping Agent — API Configuration
#  Copy this file to .env and fill in your keys
# ══════════════════════════════════════════════════════════════

# ── REQUIRED ──────────────────────────────────────────────────

# AirROI — Primary STR data provider (listings, comps, estimates)
# Sign up: https://www.airroi.com/api/developer/activate
AIRROI_API_KEY=

# Firecrawl — Property search when given a street address
# Sign up: https://www.firecrawl.dev (free tier: 500 pages)
FIRECRAWL_API_KEY=

# ── RECOMMENDED ───────────────────────────────────────────────

# Apify — Reliable Zillow scraping (no hallucination)
# Sign up: https://console.apify.com/account#/integrations (free tier available)
APIFY_TOKEN=

# ── OPTIONAL ──────────────────────────────────────────────────

# Airbtics — Market-level overlay (occupancy, ADR, listing count)
# Skipped silently if not set or market not tracked
AIRBTICS_API_KEY=
AIRBTICS_BASE_URL=https://crap0y5bx5.execute-api.us-east-2.amazonaws.com/prod

# Google Maps — Street View photos for properties without listing images
# Requires Street View Static API enabled in Google Cloud Console
GOOGLE_MAPS_API_KEY=


# Gmail — Email delivery of reports (optional)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ── RUNTIME ───────────────────────────────────────────────────

OUTPUT_DIR=./output
