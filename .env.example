# Copy this file to .env and fill in what you need.
#   cp .env.example .env
# .env is gitignored. Nothing in it ever leaves your machine.
#
# Only ONE key is required: AIRROI_API_KEY. Everything below it is optional and
# the pipeline degrades gracefully without it.


# ══ REQUIRED ══════════════════════════════════════════════════════════
# AirROI — the comp data itself: listings, comparables, TTM performance,
# revenue estimates. Without this there is no report.
# Get yours at: https://www.airroi.com/api/developer/activate
AIRROI_API_KEY=


# ══ OPTIONAL ══════════════════════════════════════════════════════════

# Firecrawl — only used to turn a street address or a Zillow/Realtor URL into a
# property. If you always pass an Airbnb URL, you do not need this: the Airbnb
# path resolves entirely through AirROI.
# Without it, address and listing-URL input will fail; Airbnb URLs still work.
# Get yours at: https://www.firecrawl.dev (sign up -> Dashboard -> API Keys)
FIRECRAWL_API_KEY=

# Anthropic — NOT required. Report narratives are written by Claude Code
# through the narrative handoff (see CLAUDE.md), which uses your existing
# Claude subscription and needs no API key. Leave this blank unless you have a
# specific reason to call the API directly.
ANTHROPIC_API_KEY=
# Model used only when ANTHROPIC_API_KEY is set. Blank = built-in default.
NARRATIVE_MODEL=

# Gmail — only if you want reports emailed with --email. Reports always save to
# ./output as HTML regardless.
# Use an APP PASSWORD, not your account password:
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=


# ══ RUNTIME ═══════════════════════════════════════════════════════════
# Where finished reports are written.
OUTPUT_DIR=./output
